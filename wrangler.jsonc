{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal-util",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portal-util-db",
      "database_id": "22f01b3d-939f-43d0-8726-6859651d3244"
    }
  ]
}
